# API base URL (only needed when backend is running)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# WebSocket URL for simulation (only needed when backend is running)
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Set to "true" to run entirely on demo/seed data without a backend
# (use this for Netlify or any static-only deployment)
NEXT_PUBLIC_DEMO_MODE=true
